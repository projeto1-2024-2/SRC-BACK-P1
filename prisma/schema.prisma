generator nestgraphql {
  provider = "node node_modules/prisma-nestjs-graphql"
  output   = "../src/shared/prismagraphql"
  reExport = "Directories"
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CONSUMER
  SUPPLIER
}

model user {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  password    String    @map("password_hash")
  phoneNumber String    @unique
  image       Bytes?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @map("updated_at")
  pseudonym   String?
  addressId   String    @default(uuid())
  address     address   @relation(fields: [addressId], references: [id], name: "UserAddress")
  contexts    context[]
  role        Role      @default(CONSUMER)
}

model product {
  id              String            @id @default(uuid())
  title           String
  description     String
  brand           String
  quantity        Int               @default(0)
  establishmentid String            @default(uuid())
  category        String?
  status          StatusEnum        
  price           Decimal
  establishment   establishment?     @relation(fields: [establishmentid], references: [id], onDelete: Cascade)
  dimensions      productDimension?
  keywords        String[]
  created_at      DateTime   @default(now()) @map("created_at")
  updated_at      DateTime   @default(now()) @map("updated_at")
  is_deleted      Boolean    @default(false)
  last_update     DateTime   @default(now()) @map("last_update")
}

enum StatusEnum {
  ACTIVE
  INACTIVE
}

model location {
  addressId String  @id @default(uuid())
  address   address @relation(fields: [addressId], references: [id])
  x         BigInt
  y         BigInt
  z         BigInt
}

model establishment {
  id              String     @id @default(uuid())
  name            String
  openingHours    String
  closingHours    String
  commercialPhone String
  taxId           String
  addressId       String?    @default(uuid())
  products        product[]
  address         address?   @relation(name: "EstablishmentAddress", fields: [addressId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @default(now()) @map("updated_at")
  password        String    @map("password_hash")
}


model address {
  id             String          @id @default(uuid())
  street         String
  number         Int
  complement     String
  neighbourhood  String
  zipCode        String
  city           String
  state          String
  location       location?
  users          user[]          @relation("UserAddress")
  establishments establishment[] @relation("EstablishmentAddress")
}

model productDimension {
  productId String  @id @default(uuid())
  length    Float?
  height    Float?
  width     Float?
  product   product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model conversation {
  id               String    @id @default(uuid())
  returnedProducts Json?
  searchRating     Int?      @default(0)
  createdAt        DateTime  @default(now())
  contexts         context[]
}

model context {
  userId         String       @default(uuid())
  conversationId String       @default(uuid())
  searchQuery    String?
  createdAt      DateTime     @default(now())
  conversation   conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
}
